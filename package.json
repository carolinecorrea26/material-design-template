{
  "name": "template-material-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "init": "npm ci && npm run catalog:check && npm run mock:seed",
    "dev": "npm run mock:dev",
    "build": "npm run catalog:check && tsc -b && vite build",
    "catalog:refresh": "node scripts/generate-component-catalog.mjs --write-catalog && npm run icons:audit && npm run docs:abe && npm run docs:handoff",
    "catalog:check": "node scripts/build-catalog.mjs --check && node scripts/generate-component-catalog.mjs --check && node scripts/check-storybook-organization.mjs && node scripts/audit-icons.mjs --check && node scripts/build-catalog-handoff.mjs --check",
    "docs:handoff": "node scripts/build-catalog-handoff.mjs",
    "docs:abe": "node scripts/build-abe-fields-document.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:fresh-start": "vitest run --config vitest.fresh-start.config.ts",
    "test:db": "node --test scripts/portal-db.test.mjs",
    "test:journeys": "vitest run src/migration/coverageJourneyAcceptance.test.ts src/migration/coverageJourneyMatrix.test.ts src/migration/coverageJourneyExceptionMatrix.test.ts src/migration/coverageHouseholdAcceptance.test.ts src/migration/coveragePortfolioAcceptance.test.ts src/domain/clientRuntimeAccuracy.test.ts src/config/coverageQuestionRequirements.test.ts",
    "test:source-propagation": "vitest run src/domain/fieldSourceParity.test.tsx src/domain/ruleTemplates.test.ts",
    "golden:write": "node scripts/golden-effective-sites.mjs --write",
    "requirements:check": "node scripts/check-requirements.mjs",
    "golden:check": "node scripts/golden-effective-sites.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run catalog:check && storybook build",
    "storybook:catalog": "node scripts/generate-component-catalog.mjs --write-catalog --add-records",
    "migration:check": "vitest run --config vitest.archive.config.ts src/migration",
    "rules:crosswalk": "REQUIREMENT_CROSSWALK_WRITE=1 vitest run --config vitest.archive.config.ts src/migration/requirementCrosswalk.test.ts",
    "rules:crosswalk:check": "REQUIREMENT_CROSSWALK_CHECK=1 vitest run --config vitest.archive.config.ts src/migration/requirementCrosswalk.test.ts",
    "migration:export": "MIGRATION_EXPORT_DIR=./migration-artifacts vitest run --config vitest.archive.config.ts src/migration/export.test.ts",
    "migration:semantic-gate": "npm run migration:export && node scripts/check-semantic-readiness.mjs",
    "mock:seed": "node scripts/seed-mock-operations.mjs",
    "db:setup": "node scripts/build-catalog.mjs --check && node --env-file-if-exists=.env scripts/seed-portal-db.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/seed-portal-db.mjs --check",
    "db:hosted:status": "node scripts/portal-release.mjs db-status",
    "db:hosted:check": "node scripts/portal-release.mjs db-check",
    "build:release": "npm run catalog:check && tsc -b && vite build && storybook build && node scripts/build-admin-html.mjs && node scripts/portal-release.mjs check-artifacts",
    "release:publish": "node scripts/portal-release.mjs publish",
    "editor:dev": "node --env-file-if-exists=.env scripts/portal-release.mjs editor-dev",
    "editor:publish:local": "node --env-file-if-exists=.env scripts/portal-release.mjs editor-local",
    "editor:publish:hosted": "node scripts/portal-release.mjs editor-hosted",
    "release:verify": "node scripts/portal-release.mjs verify",
    "mock:dev": "npm run catalog:build && npm run mock:seed && node scripts/start-mock-dev.mjs",
    "dev:catalog": "npm run catalog:build && vite",
    "pages:migrate-snapshot": "node scripts/migrate-page-snapshot.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "components:review": "node scripts/review-component-library.mjs",
    "storybook:template:check": "node scripts/check-storybook-organization.mjs && node scripts/generate-component-catalog.mjs --check && node scripts/audit-storybook-components.mjs && node scripts/review-global-template.mjs",
    "build:admin-html": "npm run catalog:check && tsc -b && node scripts/build-admin-html.mjs",
    "icons:audit": "node scripts/audit-icons.mjs",
    "test:archive": "vitest run --config vitest.archive.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/x-date-pickers": "^9.0.0",
    "@netlify/database": "2.0.4",
    "@xyflow/react": "^12.11.6",
    "dayjs": "^1.11.20",
    "framer-motion": "^12.38.0",
    "pg": "8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.5.0",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.7"
  }
}
