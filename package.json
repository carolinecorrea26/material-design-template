{
  "name": "template-material-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run mock:dev",
    "build": "npm run catalog:check && tsc -b && vite build",
    "catalog:check": "node scripts/build-catalog.mjs --check && node scripts/generate-component-catalog.mjs --check && node scripts/check-storybook-organization.mjs && node scripts/audit-icons.mjs --check && node scripts/build-abe-fields-document.mjs --check && node scripts/build-catalog-handoff.mjs --check",
    "docs:handoff": "node scripts/build-catalog-handoff.mjs",
    "docs:abe": "node scripts/build-abe-fields-document.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:asce": "vitest run src/migration/asceRequirements.test.ts src/migration/asceMcrParity.test.ts src/migration/asceBusinessDecisions.test.ts src/app/coverageRuntime.integration.test.ts src/pages/admin/library/libraryRequirements.test.ts src/persistence/mockOperationsAdapter.test.ts scripts/applicant-saves.test.mjs scripts/prototype-cutover.test.mjs",
    "golden:write": "node scripts/golden-effective-sites.mjs --write",
    "requirements:check": "node scripts/check-requirements.mjs",
    "golden:check": "node scripts/golden-effective-sites.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run storybook:catalog && storybook build",
    "storybook:catalog": "node scripts/generate-component-catalog.mjs --write-catalog --add-records",
    "migration:check": "vitest run src/migration",
    "rules:crosswalk": "REQUIREMENT_CROSSWALK_WRITE=1 vitest run src/migration/requirementCrosswalk.test.ts",
    "rules:crosswalk:check": "REQUIREMENT_CROSSWALK_CHECK=1 vitest run src/migration/requirementCrosswalk.test.ts",
    "migration:scope-audit": "node scripts/audit-active-sites.mjs",
    "migration:export": "MIGRATION_EXPORT_DIR=./migration-artifacts vitest run src/migration/export.test.ts",
    "migration:semantic-gate": "npm run migration:export && node scripts/check-semantic-readiness.mjs",
    "migration:adoption-review": "node scripts/review-active-site-adoption.mjs",
    "mock:seed": "MIGRATION_EXPORT_DIR=./migration-artifacts/mock vitest run src/migration/reviewedExport.test.ts",
    "mock:dev": "npm run catalog:build && npm run mock:seed && node scripts/start-mock-dev.mjs",
    "dev:catalog": "npm run catalog:build && vite",
    "pages:migrate-snapshot": "node scripts/migrate-page-snapshot.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "components:review": "node scripts/review-component-library.mjs",
    "storybook:template:check": "vitest run src/dev/storybook/capabilityInventory.test.ts && node scripts/review-global-template.mjs",
    "build:admin-html": "npm run catalog:check && tsc -b && node scripts/build-admin-html.mjs",
    "icons:audit": "node scripts/audit-icons.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/x-date-pickers": "^9.0.0",
    "@xyflow/react": "^12.11.6",
    "dayjs": "^1.11.20",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.5.0",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.7"
  }
}
