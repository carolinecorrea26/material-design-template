{
  "name": "template-material-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run mock:dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "npx supabase db reset",
    "db:verify-schema": "node scripts/validate-schema-postgres.mjs",
    "db:verify-asce": "npm run db:verify-schema && vitest run src/migration/asceRequirements.test.ts src/migration/asceMcrParity.test.ts src/migration/asceBusinessDecisions.test.ts src/app/coverageRuntime.integration.test.ts src/pages/admin/library/libraryRequirements.test.ts src/persistence/mockOperationsAdapter.test.ts scripts/applicant-saves.test.mjs scripts/prototype-cutover.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run storybook:catalog && storybook build",
    "library:audit": "node scripts/audit-portal-library.mjs --write",
    "storybook:catalog": "node scripts/generate-component-catalog.mjs",
    "migration:check": "vitest run src/migration",
    "migration:scope-audit": "node scripts/audit-active-sites.mjs",
    "migration:export": "MIGRATION_EXPORT_DIR=./migration-artifacts vitest run src/migration/export.test.ts",
    "migration:postgres": "node scripts/validate-migration-postgres.mjs",
    "db:verify-application-relationships": "node scripts/validate-application-relationships-postgres.mjs",
    "migration:semantic-gate": "npm run migration:export && node scripts/check-semantic-readiness.mjs",
    "migration:adoption-review": "node scripts/review-active-site-adoption.mjs",
    "mock:seed": "MIGRATION_EXPORT_DIR=./migration-artifacts/mock vitest run src/migration/reviewedExport.test.ts",
    "mock:dev": "npm run mock:seed && node scripts/start-mock-dev.mjs",
    "dev:catalog": "vite",
    "pages:migrate-snapshot": "node scripts/migrate-page-snapshot.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/x-date-pickers": "^9.0.0",
    "@supabase/supabase-js": "^2.117.1",
    "@xyflow/react": "^12.11.6",
    "dayjs": "^1.11.20",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.5.0",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.7"
  }
}
