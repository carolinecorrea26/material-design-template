      "sourceReference": "src/content/docs/urlParameters.ts",
      "parameter": "category",
      "behavior": "Restricts the site to the listed coverage category or categories. Only the specified category/categories are displayed throughout the site and Quote Tool. Supports either a single category or multiple comma-separated categories. AD is supported as a separate coverage category.",
      "status": "Modified"
    },
