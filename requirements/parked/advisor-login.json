{
  "page": "advisor-login",
  "components": [
    {
      "type": "FormRoutePage",
      "purpose": "configured Start/Continue tabs, branch-specific fields and login action",
      "components": [
        {
          "type": "FieldRenderer",
          "section": "advisor-login-new"
        },
        {
          "type": "FieldRenderer",
          "section": "advisor-login-saved"
        },
        {
          "type": "Button"
        }
      ],
      "mapping": "advisor-login"
    }
  ],
  "definition": {
    "id": "advisor-login",
    "path": "/advisor-login",
    "type": "form",
    "flow": "advisor",
    "healthGate": false,
    "displayName": "Advisor Login",
    "saveProgress": false
  },
  "position": 20,
  "layout": {
    "sections": {
      "mode": {
        "id": "advisorLoginMode",
        "for": "self",
        "fields": [
          "advisor-flow-type"
        ]
      },
      "advisor-login-new": {
        "id": "advisorLoginNew",
        "for": "self",
        "fields": [
          "advisor-email",
          "advisor-phone",
          "advisor-code"
        ],
        "when": {
          "field": "advisor-flow-type",
          "equals": "new"
        }
      },
      "advisor-login-saved": {
        "id": "advisorLoginSaved",
        "for": "self",
        "fields": [
          "applicant-email"
        ],
        "when": {
          "field": "advisor-flow-type",
          "equals": "saved"
        }
      }
    }
  },
  "content": {
    "wording": [
      "page.advisor-login.title",
      "page.advisor-login.subhead",
      "page.advisor-login.nav-title",
      "page.advisor-login.section-notes.advisor-login-new",
      "page.advisor-login.section-notes.advisor-login-saved"
    ],
    "runtime": [
      "application.ui.log-in"
    ]
  },
  "fieldMapping": {
    "page": "advisor-login"
  },
  "sections": {
    "advisor-login-new": {
      "note": "page.advisor-login.section-notes.advisor-login-new"
    },
    "advisor-login-saved": {
      "note": "page.advisor-login.section-notes.advisor-login-saved"
    }
  },
  "contentSlots": {
    "page.advisor-login.title": {
      "name": "Page title"
    },
    "page.advisor-login.subhead": {
      "name": "Page introduction"
    }
  }
}
