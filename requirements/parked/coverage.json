  "definition": {
    "id": "coverage",
    "path": "/coverage",
    "type": "form",
    "groupId": "coverage",
    "flow": "application",
    "displayName": "Coverage"
  },
  "position": 3,
  "layout": {
    "sections": {
      "portfolio": {},
      "categories": {},
      "self-personal": {
        "id": "selfCoverageQuestions",
        "for": "self",
        "title": "coverage.section.personal",
        "fields": [
          "gender",
          "smoker"
        ]
      },
      "self-tobacco": {
        "id": "selfCoverageTobacco",
        "for": "self",
        "fields": [
          "tobacco-last-used",
          "tobacco-products"
        ],
        "when": {
          "field": "smoker",
          "equals": "yes"
        },
        "presentation": "conditional"
      },
      "self-work": {
        "id": "selfCoverageWorkIncome",
        "for": "self",
        "title": "coverage.section.work",
        "fields": [
          "hours-worked-per-week",
          "average-monthly-income",
          "self-employed-under-one-year"
        ]
      },
      "spouse-personal": {
        "id": "spouseCoverageQuestions",
        "for": "spouse",
        "title": "coverage.section.personal",
        "fields": [
          "gender",
          "smoker"
        ],
        "when": {
          "field": "dependents",
          "includes": "spouse"
        }
      },
      "spouse-tobacco": {
        "id": "spouseCoverageTobacco",
        "for": "spouse",
        "fields": [
          "tobacco-last-used",
          "tobacco-products"
        ],
        "when": {
          "field": "spouse-smoker",
          "equals": "yes"
        },
        "presentation": "conditional"
      },
      "spouse-work": {
        "id": "spouseCoverageWorkIncome",
        "for": "spouse",
        "title": "coverage.section.work",
        "fields": [
          "hours-worked-per-week",
          "average-monthly-income"
        ],
        "when": {
          "field": "dependents",
          "includes": "spouse"
        }
      },
      "reveal": {},
      "products": {},
      "summary": {}
    },
    "dialogs": {
      "dependent-coverage": {}
    }
  },
  "dialogs": {
    "dependent-coverage": {
      "title": "coverage.dialog.dependent.title",
      "message": "coverage.dialog.dependent.message",
      "confirm": "coverage.dialog.dependent.confirm",
      "cancel": "coverage.dialog.dependent.cancel"
    }
  },
