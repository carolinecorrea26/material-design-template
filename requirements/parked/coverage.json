  "layout": {
    "sections": {
      "portfolio": {
        "role": "portfolio",
        "id": "coveragePortfolio",
        "fields": [],
        "display": {
          "label": "Verified coverage portfolio",
          "templates": [
            "multi",
            "single"
          ]
        }
      },
      "categories": {
        "role": "categories",
        "id": "coverageCategories",
        "fields": [],
        "display": {
          "label": "Coverage categories",
          "templates": [
            "multi",
            "single"
          ]
        }
      },
      "self-personal": {
        "id": "selfCoverageQuestions",
        "for": "self",
        "title": "coverage.section.personal",
        "fields": [
          "gender",
          "smoker"
        ],
        "role": "questions"
      },
      "self-tobacco": {
        "id": "selfCoverageTobacco",
        "for": "self",
        "fields": [
          "tobacco-last-used",
          "tobacco-products"
        ],
        "when": {
          "field": "smoker",
          "equals": "yes"
        },
        "presentation": "conditional",
        "role": "questions"
      },
      "self-work": {
        "id": "selfCoverageWorkIncome",
        "for": "self",
        "title": "coverage.section.work",
        "fields": [
          "hours-worked-per-week",
          "average-monthly-income",
          "self-employed-under-one-year",
          "actively-at-work",
          "applicant-class",
          "existing-step-rated-monthly-benefit",
          "existing-level-rated-monthly-benefit"
        ],
        "role": "questions"
      },
      "spouse-personal": {
        "id": "spouseCoverageQuestions",
        "for": "spouse",
        "title": "coverage.section.personal",
        "fields": [
          "gender",
          "smoker"
        ],
        "when": {
          "field": "dependents",
          "includes": "spouse"
        },
        "role": "questions"
      },
      "spouse-tobacco": {
        "id": "spouseCoverageTobacco",
        "for": "spouse",
        "fields": [
          "tobacco-last-used",
          "tobacco-products"
        ],
        "when": {
          "field": "spouse-smoker",
          "equals": "yes"
        },
        "presentation": "conditional",
        "role": "questions"
      },
      "spouse-work": {
        "id": "spouseCoverageWorkIncome",
        "for": "spouse",
        "title": "coverage.section.work",
        "fields": [
          "hours-worked-per-week",
          "average-monthly-income"
        ],
        "when": {
          "field": "dependents",
          "includes": "spouse"
        },
        "role": "questions"
      },
      "reveal": {
        "role": "reveal",
        "id": "coverageReveal",
        "fields": [],
        "display": {
          "label": "Reveal coverage options",
          "templates": [
            "multi",
            "single"
          ]
        }
      },
      "products": {
        "role": "products",
        "id": "coverageProducts",
        "fields": [],
        "display": {
          "label": "Products",
          "templates": [
            "multi",
            "single"
          ]
