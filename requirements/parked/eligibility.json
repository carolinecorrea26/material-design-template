  "layout": {
    "sections": {
      "self": {
        "id": "selfEligibility",
        "for": "self",
        "display": {
          "label": "Your information",
          "templates": [
            "multi",
            "single"
          ]
        }
      },
      "spouse": {
        "id": "spouseSection",
        "for": "spouse",
        "when": {
          "field": "dependents",
          "includes": "spouse"
        },
        "display": {
          "label": "Spouse information",
          "templates": [
            "multi",
            "single"
          ]
        }
      },
      "children": {
        "id": "childSection",
        "for": "child",
        "remaining": true,
        "collection": "children",
        "when": {
          "field": "dependents",
          "includes": "child"
        },
        "repeats": {
          "item": "eligibility.children.item",
          "max": "child-list-maximum",
          "grid": [
            "first-name",
            "last-name"
          ],
          "libraryLabel": "eligibility.children.library"
        },
        "display": {
          "label": "Children information",
          "templates": [
            "multi",
            "single"
          ]
        }
      }
    },
    "sectionOrder": "eligibility",
