  "fieldMapping": {
    "component": "eligibility"
  },
  "definition": {
    "id": "eligibility",
    "path": "/eligibility",
    "type": "form",
    "groupId": "get-started",
    "flow": "application",
    "displayName": "Eligibility"
  },
  "position": 2,
  "content": {
    "title": "eligibility.title",
    "subhead": "eligibility.subhead",
    "breadcrumb": "eligibility.breadcrumb",
    "loading": "eligibility.loading",
    "verification": [
      "eligibility.verification.address.title",
      "eligibility.verification.address.message",
      "eligibility.verification.address.continue",
      "eligibility.verification.cancel",
      "eligibility.verification.title",
      "eligibility.verification.close",
      "eligibility.verification.method-intro",
      "eligibility.verification.code-notice",
      "eligibility.verification.next",
      "eligibility.verification.questions-intro",
      "eligibility.verification.success.title",
      "eligibility.verification.success.body",
      "eligibility.verification.failure.title",
      "eligibility.verification.failure.body",
      "eligibility.verification.continue",
      "eligibility.verification.steps",
      "eligibility.verification.methods-label",
      "eligibility.verification.questions-label",
      "eligibility.verification.library-label"
    ],
    "inferred-state": "eligibility.inferred-state",
    "shared-navigation": [
      "navigation.next",
      "navigation.submitting",
      "navigation.back"
    ],
    "eligibility-failure": "validation.page.ineligible"
  },
  "layout": {
    "sections": {
      "self": {
        "id": "selfEligibility",
        "for": "self",
        "fields": [
          "zip-postal-code",
          "state-province",
          "birth-date",
          "dependents"
        ]
      },
      "spouse": {
        "id": "spouseSection",
        "for": "spouse",
        "fields": [
          "membership",
          "first-name",
          "last-name",
          "birth-date"
        ],
        "when": {
          "field": "dependents",
          "includes": "spouse"
        }
      },
      "children": {
        "id": "childSection",
        "for": "child",
        "remaining": true,
        "collection": "children",
        "when": {
          "field": "dependents",
          "includes": "child"
        },
        "repeats": {
          "item": "eligibility.children.item",
          "max": "child-list-maximum",
          "grid": [
            "first-name",
            "last-name"
          ]
        }
      }
    }
  },
  "shownWhen": {
    "sections": {
      "spouse": {
        "field": "dependents",
        "of": "self",
        "includes": "spouse"
      },
      "children": {
        "field": "dependents",
        "of": "self",
        "includes": "child"
      }
    }
  }
}
