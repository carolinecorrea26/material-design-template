    {
      "type": "MemberVerification",
      "mapping": "member-verification"
    },
    {
      "type": "VerificationAddress"
    }
  ],
  "sections": {
    "self": {
      "title": "people.self"
    },
    "spouse": {
      "title": "people.spouse",
      "note": "eligibility.note.spouse"
    },
    "children": {
      "title": "people.child",
      "note": "eligibility.note.children",
      "content": [
        "eligibility.children.item",
        "eligibility.children.library",
        "list.add",
        "list.edit",
        "list.remove-title",
        "list.updated",
        "list.added",
        "list.removed",
        "list.save",
        "list.cancel",
        "list.edit-action",
        "list.remove-action",
        "list.remove-named",
        "list.remove-unnamed",
        "list.remove-label"
      ]
