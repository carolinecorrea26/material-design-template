{
  "page": "beneficiary",
  "layout": {
    "sections": {
      "opt-in": {},
      "records": { "for": "beneficiary", "repeats": { "item": "Beneficiary", "max": 10, "per": "designation" } }
    },
    "dialogs": { "beneficiary": { "for": "beneficiary" }, "apply-to-others": {} }
  },
  "content": {
    "title": "beneficiary.title",
    "subhead": "beneficiary.subhead",
    "breadcrumb": "beneficiary.breadcrumb",
    "loading": "beneficiary.loading",
    "errors": ["beneficiary.error.missing"]
  },
  "help": [
    { "chip": "beneficiary.help.what-is", "text": "help.beneficiary.what-is" },
    { "chip": "beneficiary.help.share", "text": "help.beneficiary.share" }
  ],
  "behavior": [
    "Beneficiaries are collected for each Life and AD&D product selected for the applicant or the spouse. For a covered child, the beneficiary is the member.",
    "Each product and applicant can have up to ten primary and ten contingent beneficiaries.",
    "The shares of the individual beneficiaries in a designation must total 100%. A trust receives 100%.",
    "Saving a new beneficiary offers to apply it to the applicant's other coverages.",
    "When the page is required, at least one beneficiary must be added before continuing. When it is optional, the opt-in question decides."
  ],
  "sections": {
    "records": {
      "content": [
        "beneficiary.add",
        "beneficiary.designation.primary",
        "beneficiary.designation.contingent",
        "beneficiary.note.replaces-prior",
        "beneficiary.note.new-insurance",
        "beneficiary.full",
        "beneficiary.no-products"
      ]
    }
  },
  "dialogs": {
    "beneficiary": { "title": "beneficiary.dialog.add-title", "editTitle": "beneficiary.dialog.edit-title" },
    "apply-to-others": {
      "title": "beneficiary.apply.title",
      "message": "beneficiary.apply.prompt",
      "confirm": "beneficiary.apply.confirm",
      "cancel": "beneficiary.apply.cancel"
    }
  },
  "shownWhen": {
    "sections": {
      "opt-in": { "pageRequirement": "optional" },
      "records": {
        "any": [{ "pageRequirement": "required" }, { "field": "beneficiary-information-opt-in", "equals": "yes" }]
      }
    },
    "dialogs": { "apply-to-others": "A new beneficiary was saved and the applicant has other coverages." },
    "fields": [
      {
        "field": "first-name",
        "dialog": "beneficiary",
        "shownWhen": { "field": "beneficiary-type", "equals": "individual" }
      },
      {
        "field": "last-name",
        "dialog": "beneficiary",
        "shownWhen": { "field": "beneficiary-type", "equals": "individual" }
      },
      {
        "field": "beneficiary-relationship",
        "dialog": "beneficiary",
        "shownWhen": { "field": "beneficiary-type", "equals": "individual" }
      },
      {
        "field": "beneficiary-share",
        "dialog": "beneficiary",
        "shownWhen": { "field": "beneficiary-type", "equals": "individual" }
      },
      {
        "field": "beneficiary-trust-name",
        "dialog": "beneficiary",
        "shownWhen": { "field": "beneficiary-type", "equals": "trust" }
      },
      {
        "field": "beneficiary-trust-date",
        "dialog": "beneficiary",
        "shownWhen": { "field": "beneficiary-type", "equals": "trust" }
      }
    ]
  }
}
