  "definition": {
    "id": "profile",
    "path": "/profile",
    "type": "form",
    "groupId": "profile",
    "flow": "application",
    "healthGate": false,
    "displayName": "Profile"
  },
  "position": 6,
  "layout": {
    "sections": {
      "profile-personal-self": {
        "id": "profilePersonalSelf",
        "fields": [
          "height-feet",
          "height-inches",
          "weight-lbs",
          "weight-12-months-ago-lbs",
          "social-security-number",
          "marital-status",
          "has-drivers-license",
          "intend-live-outside-us",
          "travel-outside-us-six-months"
        ],
        "for": "self",
        "title": "profile.section.personal"
      },
      "profile-personal-self-drivers-license": {
        "id": "profilePersonalSelfDriversLicense",
        "fields": [
          "drivers-license-number",
          "drivers-license-state"
        ],
        "for": "self",
        "when": {
          "field": "has-drivers-license",
          "equals": "yes"
        }
      },
      "profile-personal-self-outside-us": {
        "id": "profilePersonalSelfOutsideUs",
        "fields": [
          "outside-us-country"
        ],
        "for": "self",
        "when": {
          "field": "intend-live-outside-us",
          "equals": "yes"
        }
      },
      "profile-personal-self-travel-outside-us": {
        "id": "profilePersonalSelfTravelOutsideUs",
        "fields": [
          "travel-outside-us-country"
        ],
        "for": "self",
        "when": {
          "field": "travel-outside-us-six-months",
          "equals": "yes"
        }
      },
      "profile-personal-self-physician": {
        "id": "profilePersonalSelfPhysician",
        "fields": [
          "physician-first-name",
          "physician-last-name",
          "physician-phone",
          "medical-facility-name",
          "medical-facility-street-address",
          "medical-facility-apt-suite",
          "medical-city",
          "medical-state",
          "medical-zip-code"
        ],
        "for": "self",
        "title": "physician.title",
        "enabledByConfiguration": "physician-information"
      },
      "profile-financial-self": {
        "id": "profileFinancialSelf",
        "fields": [
          "has-other-life-insurance",
          "existing-life-insurance-amount",
          "is-replacing-life-insurance",
          "has-pending-life-insurance-applications",
          "pending-life-insurance-amount",
          "pending-life-insurance-company",
          "has-disability-insurance",
          "is-replacing-disability-insurance",
          "disability-replacement-amount"
        ],
        "for": "self",
        "title": "profile.section.other-coverage",
        "coverageCategories": [
          "LI",
          "DI"
        ],
        "enabledByConfiguration": "other-coverage-information"
      },
      "profile-financial-questionnaire-self": {
        "id": "profileFinancialQuestionnaireSelf",
        "fields": [
          "total-net-worth",
          "total-annual-unearned-income",
          "is-self-employed",
          "is-sole-proprietor",
          "is-professional-corporation",
          "sole-proprietor-gross-income",
          "sole-proprietor-gross-earnings",
          "sole-proprietor-business-expenses",
          "professional-corporation-annual-salary",
          "professional-corporation-s-corp-distribution",
          "professional-corporation-dividends",
          "professional-corporation-bonus",
          "bonus-payment-frequency",
          "professional-corporation-commission",
          "commission-payment-frequency",
          "professional-corporation-benefits-cost",
          "years-self-employed",
          "work-from-home",
          "has-work-location-outside-home",
          "work-location-details"
        ],
        "for": "self",
        "title": "profile.section.financial-questionnaire"
      },
      "profile-personal-spouse": {
        "id": "profilePersonalSpouse",
        "fields": [
          "height-feet",
          "height-inches",
          "weight-lbs",
          "weight-12-months-ago-lbs",
          "social-security-number",
          "has-drivers-license",
          "intend-live-outside-us",
          "travel-outside-us-six-months"
        ],
        "for": "spouse",
        "title": "profile.section.personal",
        "when": {
          "field": "dependents",
          "includes": "spouse"
        }
      },
      "profile-personal-spouse-drivers-license": {
        "id": "profilePersonalSpouseDriversLicense",
        "fields": [
          "drivers-license-number",
          "drivers-license-state"
        ],
        "for": "spouse",
        "when": {
          "all": [
            {
              "field": "dependents",
              "includes": "spouse"
            },
            {
              "field": "has-drivers-license",
              "equals": "yes",
              "of": "spouse"
            }
          ]
        }
      },
      "profile-personal-spouse-outside-us": {
        "id": "profilePersonalSpouseOutsideUs",
        "fields": [
          "outside-us-country"
        ],
        "for": "spouse",
        "when": {
          "all": [
            {
              "field": "dependents",
              "includes": "spouse"
            },
            {
              "field": "intend-live-outside-us",
              "equals": "yes",
              "of": "spouse"
            }
          ]
        }
      },
      "profile-personal-spouse-travel-outside-us": {
        "id": "profilePersonalSpouseTravelOutsideUs",
        "fields": [
          "travel-outside-us-country"
        ],
        "for": "spouse",
