                    <Box sx={{ textAlign: { xs: 'center', md: 'left' } }}>
                      <Typography variant="h5" gutterBottom sx={{ fontWeight: 600 }}>
                        Apply online
                      </Typography>
                      <Typography color="text.secondary" variant="body1">
