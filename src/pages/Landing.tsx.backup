                    to={features.showMembershipPage ? '/membership' : '/eligibility'} 
                    variant="contained" 
                    size="large"
                    endIcon={<ArrowRightAltIcon />}
                    sx={{ 
                      py: 1.5, 
                      px: 4,
                      width: { xs: '100%', sm: 'auto' }
                    }}
                  >
                    Begin Application
                  </Button>
                  <Button 
                    onClick={scrollToQuote}
                    variant="outlined" 
                    size="large"
                    sx={{ 
                      py: 1.5, 
                      px: 4,
                      width: { xs: '100%', sm: 'auto' },
                      display: hideQuote ? 'none' : 'flex'
                    }}
                  >
                    Get Instant Quote
                  </Button>
                </Stack>
              )}
            </Stack>
          </Box>
        </Container>
      </Box>

      {/* Quote Tool Section */}
      {!hideNonHero && !hideQuote && (
