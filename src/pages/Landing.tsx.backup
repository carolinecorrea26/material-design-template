            bgcolor: '#f9fafc',
            borderTop: 1,
            borderBottom: 1,
            borderColor: 'divider',
            py: 1.5,
            overflow: 'hidden',
            position: 'relative'
          }}
        >
          <Box
            sx={{
              display: 'flex',
              gap: { xs: 4, sm: '12rem' },
              alignItems: 'center',
              animation: 'scroll 120s linear infinite',
              '@keyframes scroll': {
                '0%': {
                  transform: 'translateX(0)'
                },
                '100%': {
                  transform: 'translateX(-50%)'
                }
              },
              '&:hover': {
                animationPlayState: 'paused'
              }
            }}
          >
            {/* First set of ratings */}
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                A++
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                A.M. Best
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                AAA
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                Fitch Ratings
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                Aa1
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                Moody's Investors Service
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                AA+
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                Standard & Poor's
              </Typography>
            </Box>

            {/* First set of ratings */}
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                A++
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                A.M. Best
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                AAA
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                Fitch Ratings
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                Aa1
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                Moody's Investors Service
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                AA+
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                Standard & Poor's
              </Typography>
            </Box>

            {/* First set of ratings */}
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                A++
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                A.M. Best
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                AAA
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                Fitch Ratings
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                Aa1
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                Moody's Investors Service
              </Typography>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, whiteSpace: 'nowrap' }}>
              <Typography variant="body2" sx={{ fontWeight: 600, color: 'success.main', fontSize: '1.25rem' }}>
                AA+
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary', fontSize: '0.75rem' }}>
                Standard & Poor's
              </Typography>
            </Box>
          </Box>
        </Box>
